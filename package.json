{
  "name": "gocomet-nova-part1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @nova/api\" \"npm run dev -w @nova/web\"",
    "build": "npm run build -w @nova/web",
    "start": "npm run start -w @nova/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @nova/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
