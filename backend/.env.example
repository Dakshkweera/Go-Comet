HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/nova.db
UPLOAD_DIR=./data/uploads

# Comma-separated list of frontend origins allowed to call this API (use * only for demos).
# Production: your Vercel URL, e.g. https://nova-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# fake | openrouter (openrouter needs LLM_API_KEY and all *_MODEL values)
LLM_PROVIDER=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
EXTRACTOR_MODEL=google/gemini-2.5-pro
QUERY_ROUTER_MODEL=google/gemini-2.5-flash
SQL_MODEL=google/gemini-2.5-flash
ANSWER_MODEL=google/gemini-2.5-flash

EXTRACTION_MIN_CONFIDENCE=0.8
MAX_UPLOAD_MB=15
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=60000
