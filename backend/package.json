{
  "name": "nova-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "samples": "tsx scripts/make-samples.ts",
    "samples:emails": "tsx scripts/make-email-samples.ts",
    "samples:demo": "tsx scripts/make-demo-emails.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "mailparser": "^3.9.38",
    "multer": "^2.0.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
