HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/nova.db
UPLOAD_DIR=./data/uploads
WEB_DIST_DIR=./apps/web/dist

# fake | openrouter (openrouter needs LLM_API_KEY and all *_MODEL values)
LLM_PROVIDER=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
EXTRACTOR_MODEL=
QUERY_ROUTER_MODEL=
SQL_MODEL=
ANSWER_MODEL=

EXTRACTION_MIN_CONFIDENCE=0.8
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=10
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=60000
